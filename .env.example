# Required
DATABASE_URL=postgres://user:pass@host:5432/db
PUBLIC_URL=https://your-domain.example          # used for the Paystack return link
ADMIN_PASSWORD=change-me-to-12-plus-characters  # /admin.html login (user: admin)

# Taobao data (leave empty to run the sample catalogue; checkout stays off)
TAOBAO_API_KEY=
TAOBAO_API_SECRET=
TAOBAO_API_BASE=https://api-gw.onebound.cn
TAOBAO_LANG=                                    # cn or en; default en without DeepL, cn with it

# Translation (recommended for live data)
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Payments (Paystack, Ghana)
PAYSTACK_SECRET_KEY=                            # sk_test_... first, then sk_live_...
PAYSTACK_CURRENCY=GHS
GHS_PER_USD=                                    # update daily; customers are charged in cedis

# Pricing (defaults shown)
CNY_PER_USD=7.1
MARKUP=1.2
AIR_USD_PER_KG=15
AIR_MIN_KG=0.5
SEA_FLAT_USD=10
SEA_FLAT_MAX_CBM=0.02
SEA_USD_PER_CBM_OVER=500
SERVICE_FEE_USD=2
DOMESTIC_CNY_PER_PARCEL=5.6
PACKING_KG_PER_ORDER=0.3
DEFAULT_WEIGHT_KG=0.5
HOME_DELIVERY_USD=                              # leave empty to offer pickup only

# Optional
PICKUP_ADDRESS=
SUPPORT_WHATSAPP=                               # e.g. 233201234567
PRODUCT_CACHE_HOURS=6
RATE_LIMIT_PER_MIN=120
